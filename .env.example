# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Apple Push Notification service (server only)
APNS_TEAM_ID=your-apple-developer-team-id
APNS_BUNDLE_ID=com.ivantomicic.gweilo
# Xcode Debug builds register with the APNs Sandbox environment.
APNS_DEVELOPMENT_KEY_ID=your-sandbox-apns-key-id
APNS_DEVELOPMENT_PRIVATE_KEY_BASE64=base64-encoded-sandbox-p8-file
# TestFlight and App Store builds register with the APNs Production environment.
APNS_PRODUCTION_KEY_ID=your-production-apns-key-id
APNS_PRODUCTION_PRIVATE_KEY_BASE64=base64-encoded-production-p8-file
